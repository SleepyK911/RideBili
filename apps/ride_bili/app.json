      "name": "VIEW",
      "kind": "canvas",
      "title": "小宁兄弟 - ( ゜- ゜)つロ 乾杯~",
      "hmi": false,
      "bg": "#0f0f0f",
      "buttons": [
        [
          "BTN_PLAY",
          "播放"
        ],
        [
          "BTN_RW",
          "-10 s"
        ],
        [
          "BTN_FF",
          "+10 s"
        ],
        [
          "BTN_LIST",
          "播放器"
        ],
        [
          "BTN_FIND",
          "搜索"
        ],
        [
          "BTN_SETTINGS",
          "设置"
        ]
      ],
      "items": [],
