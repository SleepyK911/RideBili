{
  "id": "ride_bili",
  "title": "RideBili",
  "description": "BMW iDrive 7 非官方 B 站客户端，支持扫码登录、视频搜索和流畅优先播放。",
  "version": "0.1.21",
  "license": "GPL-3.0-or-later",
  "vendor": "custom",
  "loggingId": "OBIL",
  "iconGlyph": "哔",
  "signals": {
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": [
        "connect",
        "disconnect",
        "getListMainConnections"
      ],
      "_optional": "实时音频"
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": [
        "hookSourceAvailablityStatusChange"
      ],
      "_optional": "实时音频"
    }
  },
  "screens": [
