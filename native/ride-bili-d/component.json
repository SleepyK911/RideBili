{
  "id": "ride-bili-d",
  "kind": "tool",
  "version": "0.1.21",
  "license": "GPL-3.0-or-later",
  "title": "RideBili 播放服务",
  "description": "B 站接口、音频及 H.264 硬解码。",
  "requires": {
    "mgu-deploy": "0.7.0",
    "mgu-python": "1.0.2",
    "jap-node22": "22.23.4",
    "mgu-render": "0.6.16"
  },
  "uninstallable": true,
  "internet": true,
  "uids": "state/internet-uids",
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "ytd.js",
      "from": "ytd.js",
      "mode": "0644"
    },
    {
      "path": "bili.js",
      "from": "bili.js",
      "mode": "0644"
    },
    {
      "path": "bili-dec",
      "from": "build/ytdec",
      "mode": "0755"
    },
    {
      "path": "ytfetch.py",
      "from": "ytfetch.py",
      "mode": "0644"
    },
    {
      "path": "realtime.js",
      "from": "realtime.js",
      "mode": "0644"
    },
    {
      "path": "pcmout.py",
      "from": "pcmout.py",
      "mode": "0644"
    },
    {
      "path": "mgu-pcm",
      "from": "build/mgu-pcm",
      "mode": "0755"
    },
    {
      "path": "thumb.js",
      "from": "thumb.js",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/decoder.js",
      "from": "vendor/jpeg-js/decoder.js",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/LICENSE",
      "from": "vendor/jpeg-js/LICENSE",
      "mode": "0644"
    },
    {
      "path": "check.sh",
      "from": "check.sh",
      "mode": "0755"
    },
    {
      "path": "LICENSE",
      "from": "../../LICENSE",
      "mode": "0644"
    },
    {
      "path": "THIRD_PARTY_LICENSES",
      "from": "../../THIRD_PARTY_LICENSES",
      "mode": "0644"
    },
    {
      "path": "mgu-audio",
      "from": "build/mgu-audio",
      "mode": "0755"
    },
    {
      "path": "AUDIO-LICENSE",
      "from": "AUDIO-LICENSE",
      "mode": "0644"
    }
  ],
  "check": [
    "check.sh"
  ],
  "units": [
    {
      "name": "ride-bili-d.service",
      "from": "systemd/ride-bili-d.service"
    }
  ],
  "enable": [
    {
      "unit": "ride-bili-d.service",
      "target": "multi-user.target"
    }
  ],
  "crashNames": [
    "bili-dec"
  ],
  "recmgr": [
    "ride-bili-d"
  ],
  "restart": [
    "ride-bili-d.service"
  ]
}
