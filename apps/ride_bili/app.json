  "settings": [
    {
      "key": "audioMode",
      "label": "音频播放",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "实时音频（推荐）"
        ],
        [
          "mp3",
          "兼容 MP3"
        ]
      ]
    },
    {
      "key": "defaultQuality",
      "label": "默认读取清晰度",
      "type": "choice",
      "default": "auto",
      "options": [
        ["auto", "自动（优先 480P）"],
        ["360", "360P"],
        ["480", "480P"],
        ["720", "720P"],
        ["1080", "1080P"]
      ]
    },
    {
      "key": "fill",
      "label": "填满屏幕（裁切画面）",
      "type": "bool",
      "default": false,
      "reset": 2
    },
    {
      "key": "quitApp",
      "label": "完全退出应用",
      "type": "action"
    },
    {
      "key": "copyright",
